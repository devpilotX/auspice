# Auspice configuration. Copy to .env and fill in. Never commit .env.
#
# infra/scripts/bootstrap-postgres.ps1 writes the two database URLs for you.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
AUSPICE_ENV=development
AUSPICE_DATABASE_URL=postgresql+psycopg://auspice:password@127.0.0.1:55432/auspice
AUSPICE_TEST_DATABASE_URL=postgresql+psycopg://auspice:password@127.0.0.1:55432/auspice_test

# ---------------------------------------------------------------------------
# Raw object store. The corpus is content addressed and never overwritten.
# backend=local writes under AUSPICE_RAW_LOCAL_ROOT, which is what development uses.
# backend=s3 targets Cloudflare R2 or any S3 compatible endpoint.
# ---------------------------------------------------------------------------
AUSPICE_RAW_BACKEND=local
AUSPICE_RAW_LOCAL_ROOT=data/raw
AUSPICE_RAW_BUCKET=
AUSPICE_RAW_ENDPOINT_URL=
AUSPICE_RAW_ACCESS_KEY_ID=
AUSPICE_RAW_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------------
# Crawler identity. Section 15.2: identify honestly, publish a contact address.
# Requests are refused by the ingest layer if the contact address is missing.
# ---------------------------------------------------------------------------
AUSPICE_CRAWLER_USER_AGENT=AuspiceBot/0.1 (+https://auspice.example/crawler)
AUSPICE_CRAWLER_CONTACT=crawler@auspice.example
AUSPICE_CRAWLER_REQUESTS_PER_MINUTE=20
AUSPICE_CRAWLER_TIMEOUT_SECONDS=45

# ---------------------------------------------------------------------------
# Language models. Extraction uses the frontier tier, triage the cheap tier.
# With no key present the extraction layer refuses to run rather than inventing
# facts, and the pipeline reports the stage as unavailable.
# ---------------------------------------------------------------------------
AUSPICE_LLM_PROVIDER=anthropic
AUSPICE_LLM_API_KEY=
AUSPICE_LLM_BASE_URL=
AUSPICE_LLM_FRONTIER_MODEL=claude-sonnet-4-5-20260929
AUSPICE_LLM_CHEAP_MODEL=claude-haiku-4-5-20261001
AUSPICE_LLM_MAX_ATTEMPTS=3

# ---------------------------------------------------------------------------
# Transcription
# ---------------------------------------------------------------------------
AUSPICE_WHISPER_MODEL=large-v3
AUSPICE_WHISPER_DEVICE=cpu
AUSPICE_FFMPEG_PATH=ffmpeg

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
AUSPICE_API_HOST=127.0.0.1
AUSPICE_API_PORT=8000
AUSPICE_API_CORS_ORIGINS=http://localhost:3000
# Comma separated. Format: key:label:tier. Tier is one of screen, team, enterprise, county.
# Believe X-Forwarded-For when rate limiting. Only turn this on when a proxy in front is guaranteed to
# overwrite it, since a client can set it freely and would otherwise get an unlimited allowance.
AUSPICE_API_TRUST_FORWARDED_FOR=false
AUSPICE_API_KEYS=

# ---------------------------------------------------------------------------
# Deployment. Required by infra/docker-compose.yml and unset by design: the api
# service has no CORS default there, because inheriting the development default
# means a deployed interface is refused by the API while the API looks healthy.
#
# AUSPICE_API_CORS_ORIGINS is the web origin, comma separated, with no trailing
# slash. AUSPICE_PUBLIC_HOST is the hostname the reverse proxy answers on and
# requests a certificate for, so it must resolve to the machine before the stack
# is started.
# ---------------------------------------------------------------------------
# AUSPICE_API_CORS_ORIGINS=https://permissionbureau.com
# AUSPICE_PUBLIC_HOST=api.permissionbureau.com

# ---------------------------------------------------------------------------
# Ledger. The signing key commits the daily Merkle root. Losing it does not
# invalidate history, because the chain itself is verifiable, but it does break
# the continuity of the published signature.
# ---------------------------------------------------------------------------
AUSPICE_LEDGER_PATH=data/ledger
AUSPICE_LEDGER_ANCHOR_URL=

# ---------------------------------------------------------------------------
# Observability. Both are empty by default and both fail closed.
#
# No DSN means no error tracker starts and no network call leaves the process. A
# service that reads nothing but public records should not acquire a third party
# data processor because a default was left on. Needs `uv sync --extra
# observability`; with a DSN set and the package absent the service still starts
# and logs a warning, because silently missing error reporting is the thing being
# fixed here.
#
# No metrics token means the /metrics route is not registered at all, rather than
# registered and answering 401. An unauthenticated metrics endpoint publishes
# request volumes, error rates and model identity, and a route that does not exist
# cannot be probed. With a token set, scrape it with
# `Authorization: Bearer <token>`; a wrong token gets 404, not 401.
#
# Every response carries X-Request-Id whether or not either of these is set. That
# identifier is in the body of every 500, so a customer can quote it.
# ---------------------------------------------------------------------------
AUSPICE_SENTRY_DSN=
AUSPICE_SENTRY_TRACES_SAMPLE_RATE=0.0
AUSPICE_METRICS_TOKEN=

# ---------------------------------------------------------------------------
# Alert delivery. Section 6.11: monitoring is what turns a report into a
# subscription, so an alert that is recorded and never sent is a missing product
# rather than a missing feature.
#
# channel=log is the default and needs no credentials. It writes every alert to
# the structured log, so an unconfigured deployment is observably doing the right
# thing and can be checked by reading the log. What this avoids is a deployment
# that looks healthy because nothing errored while nothing was sent.
#
# Setting the channel to webhook or smtp without its required values raises at
# startup of the delivery command rather than falling back to the log. An
# operator who configured mail wants to hear that it is broken now.
#
# Delivery is at least once. The send happens, then the row is marked, then the
# transaction commits, so a crash in between re-sends. A webhook receiver should
# deduplicate on alert_id, which is in every payload for that reason.
#
# FALLBACK_RECIPIENT is where a mail alert goes when watch.subscriber is an API
# key label rather than an address, which the schema says it is until billing
# exists. Unset, such a send fails loudly and the alert stays queued. Either way
# it is never silently dropped.
# ---------------------------------------------------------------------------
AUSPICE_ALERT_CHANNEL=log
AUSPICE_ALERT_MAX_DELIVERY_ATTEMPTS=5
AUSPICE_ALERT_WEBHOOK_URL=
AUSPICE_ALERT_SMTP_HOST=
AUSPICE_ALERT_SMTP_PORT=587
AUSPICE_ALERT_SMTP_USERNAME=
AUSPICE_ALERT_SMTP_PASSWORD=
AUSPICE_ALERT_SMTP_STARTTLS=true
AUSPICE_ALERT_SENDER=
AUSPICE_ALERT_FALLBACK_RECIPIENT=

# ---------------------------------------------------------------------------
# Web
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
