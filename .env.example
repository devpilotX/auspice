# Auspice configuration. Copy to .env and fill in. Never commit .env.
#
# infra/scripts/bootstrap-postgres.ps1 writes the two database URLs for you.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
AUSPICE_ENV=development
AUSPICE_DATABASE_URL=postgresql+psycopg://auspice:password@127.0.0.1:55432/auspice
AUSPICE_TEST_DATABASE_URL=postgresql+psycopg://auspice:password@127.0.0.1:55432/auspice_test

# ---------------------------------------------------------------------------
# Raw object store. The corpus is content addressed and never overwritten.
# backend=local writes under AUSPICE_RAW_LOCAL_ROOT, which is what development uses.
# backend=s3 targets Cloudflare R2 or any S3 compatible endpoint.
# ---------------------------------------------------------------------------
AUSPICE_RAW_BACKEND=local
AUSPICE_RAW_LOCAL_ROOT=data/raw
AUSPICE_RAW_BUCKET=
AUSPICE_RAW_ENDPOINT_URL=
AUSPICE_RAW_ACCESS_KEY_ID=
AUSPICE_RAW_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------------
# Crawler identity. Section 15.2: identify honestly, publish a contact address.
# Requests are refused by the ingest layer if the contact address is missing.
# ---------------------------------------------------------------------------
AUSPICE_CRAWLER_USER_AGENT=AuspiceBot/0.1 (+https://auspice.example/crawler)
AUSPICE_CRAWLER_CONTACT=crawler@auspice.example
AUSPICE_CRAWLER_REQUESTS_PER_MINUTE=20
AUSPICE_CRAWLER_TIMEOUT_SECONDS=45

# ---------------------------------------------------------------------------
# Language models. Extraction uses the frontier tier, triage the cheap tier.
# With no key present the extraction layer refuses to run rather than inventing
# facts, and the pipeline reports the stage as unavailable.
# ---------------------------------------------------------------------------
AUSPICE_LLM_PROVIDER=anthropic
AUSPICE_LLM_API_KEY=
AUSPICE_LLM_BASE_URL=
AUSPICE_LLM_FRONTIER_MODEL=claude-sonnet-4-5-20260929
AUSPICE_LLM_CHEAP_MODEL=claude-haiku-4-5-20261001
AUSPICE_LLM_MAX_ATTEMPTS=3

# ---------------------------------------------------------------------------
# Transcription
# ---------------------------------------------------------------------------
AUSPICE_WHISPER_MODEL=large-v3
AUSPICE_WHISPER_DEVICE=cpu
AUSPICE_FFMPEG_PATH=ffmpeg

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
AUSPICE_API_HOST=127.0.0.1
AUSPICE_API_PORT=8000
AUSPICE_API_CORS_ORIGINS=http://localhost:3000
# Comma separated. Format: key:label:tier. Tier is one of screen, team, enterprise, county.
AUSPICE_API_KEYS=

# ---------------------------------------------------------------------------
# Ledger. The signing key commits the daily Merkle root. Losing it does not
# invalidate history, because the chain itself is verifiable, but it does break
# the continuity of the published signature.
# ---------------------------------------------------------------------------
AUSPICE_LEDGER_PATH=data/ledger
AUSPICE_LEDGER_ANCHOR_URL=

# ---------------------------------------------------------------------------
# Web
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
